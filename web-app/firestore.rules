rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validBusiness(data) {
      return data.keys().hasAll([
          'name', 'normalizedName', 'categoryId', 'categoryLabel', 'cityId', 'city',
          'address', 'phone', 'latitude', 'longitude', 'rating', 'reviewCount',
          'verified', 'services', 'imageUrl', 'description', 'status', 'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 160
        && data.normalizedName is string
        && data.categoryId is string
        && data.cityId is string
        && data.latitude is number
        && data.latitude >= 7.0
        && data.latitude <= 13.0
        && data.longitude is number
        && data.longitude >= -16.0
        && data.longitude <= -7.0
        && data.rating is number
        && data.rating >= 0
        && data.rating <= 5
        && data.reviewCount is int
        && data.reviewCount >= 0
        && data.verified is bool
        && data.services is list
        && data.status in ['draft', 'pending', 'approved', 'rejected', 'closed', 'duplicate'];
    }

    match /businesses/{businessId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update: if isAdmin() && validBusiness(request.resource.data);
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if resource.data.status == 'approved'
          || isAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'businessId', 'userId', 'rating', 'text', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.businessId == businessId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'preferredCityId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'preferredCityId', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /favorites/{businessId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['businessId', 'createdAt'])
          && request.resource.data.businessId == businessId
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    function validSubmissionFields(data) {
      return data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 160
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 100))
        && (!('subcategoryId' in data) || (data.subcategoryId is string && data.subcategoryId.size() <= 100))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('district' in data) || (data.district is string && data.district.size() <= 100))
        && (!('quartier' in data) || (data.quartier is string && data.quartier.size() <= 100))
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 20))
        && (!('streetAddress' in data) || (data.streetAddress is string && data.streetAddress.size() <= 180))
        && (!('description' in data) || (data.description is string && data.description.size() <= 800))
        && (!('photo' in data) || validSubmissionPhoto(data.photo))
        && (!('imagePaths' in data) || validSubmissionGallery(data.imagePaths));
    }

    function validSubmissionPhoto(value) {
      return value is string
        && value.size() <= 300000
        && (value == '' || value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }

    function validGalleryPhoto(value) {
      return value is string
        && value.size() <= 140000
        && value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    function validSubmissionGallery(values) {
      return values is list
        && values.size() <= 4
        && (values.size() < 1 || validGalleryPhoto(values[0]))
        && (values.size() < 2 || validGalleryPhoto(values[1]))
        && (values.size() < 3 || validGalleryPhoto(values[2]))
        && (values.size() < 4 || validGalleryPhoto(values[3]));
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'submitterId', 'name', 'categoryId', 'cityId', 'communeId', 'address',
          'phone', 'email', 'website', 'whatsapp', 'latitude', 'longitude',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'submitterId', 'name', 'categoryId', 'cityId', 'communeId', 'address',
          'phone', 'email', 'website', 'whatsapp', 'latitude', 'longitude',
          'description', 'imagePaths', 'status', 'createdAt', 'updatedAt',
          'category', 'subcategory', 'subcategoryId', 'city', 'district',
          'quartier', 'postalCode', 'streetAddress', 'photo'
        ])
        && request.resource.data.submitterId == request.auth.uid
        && validSubmissionFields(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin()
        || (signedIn() && resource.data.submitterId == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && resource.data.submitterId == request.auth.uid
        && resource.data.status in ['approved', 'correction_required', 'rejected']
        && request.resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'subcategory', 'categoryId', 'subcategoryId', 'city', 'cityId',
          'district', 'communeId', 'quartier', 'postalCode', 'streetAddress', 'address',
          'phone', 'email', 'website', 'whatsapp', 'description', 'latitude', 'longitude',
          'photo', 'imagePaths', 'status', 'updatedAt', 'editRequestId', 'verificationChecks'
        ])
        && request.resource.data.editRequestId is string && request.resource.data.editRequestId.size() == 36
        && request.resource.data.verificationChecks == {'identity': false, 'contact': false, 'location': false, 'duplicate': false}
        && validSubmissionFields(request.resource.data)
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.website is string && request.resource.data.website.size() <= 2000
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 30
        && ((request.resource.data.latitude == null && request.resource.data.longitude == null)
          || (request.resource.data.latitude is number && request.resource.data.latitude >= 7 && request.resource.data.latitude <= 13
            && request.resource.data.longitude is number && request.resource.data.longitude >= -16 && request.resource.data.longitude <= -7))
      );
    }

    match /deletionRequests/{requestId} {
      allow create: if signedIn()
        && requestId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin() || (signedIn() && requestId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Source provenance, duplicate signals, RCCM checks and reviewer notes stay private.
    match /businessRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    // Immutable operational history for moderation decisions.
    match /adminAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
